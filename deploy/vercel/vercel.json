{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/zyko.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/v1/chat/completions", "destination": "/api/zyko" },
    { "source": "/v1/models", "destination": "/api/zyko" },
    { "source": "/healthz", "destination": "/api/zyko" }
  ],
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" }
      ]
    }
  ]
}
